# Copiar a .env (que está en .gitignore) o configurar en el Space.
# NINGUNA de estas variables lleva un secreto en este archivo.

# --- qué configuración se sirve -----------------------------------------
# La configuración se ELIGE aquí; no se deduce de qué adaptador haya en el
# disco. `app/configuraciones.py` las declara con su resultado medido.
#   s08d               18/21  POR DEFECTO · la mejor medida
#   s08c               13/21  control: s08d sin enrutador
#   solo_lora          14/21  respaldo simple
#   agente_c5ft        13/21  la agéntica, para comparar
#   s08d_herramientas    —    EXPERIMENTAL, sin medir
#   s08d_verificador     —    EXPERIMENTAL, sin medir
#   s08d_normalizador    —    EXPERIMENTAL, sin medir
#   s08d_vision          —    EXPERIMENTAL, sin medir
# Las EXPERIMENTAL se marcan como tales en pantalla y en /salud.
TUTOR_CONFIG=s08d

# --- modelo -------------------------------------------------------------
TUTOR_MODELO_BASE=Qwen/Qwen2.5-1.5B-Instruct
# Rutas de los adaptadores. CUÁL se carga lo decide TUTOR_CONFIG, no la
# presencia del archivo: cargar el que esté en el disco fue el fallo que llevó
# a servir una variante de C5 (12/21) bajo el nombre de S08-D.
TUTOR_ADAPTADOR_M1=adaptadores/qwen-lora
TUTOR_ADAPTADOR_AGENTE=adaptadores/qwen-lora-agente
TUTOR_VLM=Qwen/Qwen2-VL-2B-Instruct

# int4 para caber en el hardware gratuito del Space. Vacío = fp16.
TUTOR_CUANTIZAR=

# --- privacidad ---------------------------------------------------------
# Por defecto NO se registra el texto del usuario: solo longitud y hash.
# Ponerlo a 1 solo con consentimiento explícito.
TUTOR_LOG_TEXTO=

# --- telemetría opcional ------------------------------------------------
# WANDB_API_KEY se configura como SECRETO del Space, nunca aquí.
WANDB_PROJECT=tutor-m5

# --- servidor -----------------------------------------------------------
PORT=7860
# En Kaggle, usar 1 para que Gradio publique un enlace temporal de la sesión.
# Vacío (por defecto) = sin túnel público; dejarlo vacío en Spaces.
TUTOR_GRADIO_SHARE=
